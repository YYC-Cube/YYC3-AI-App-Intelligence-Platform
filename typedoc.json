{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["./types/index.ts", "./hooks/index.ts"],
  "out": "docs/api-reference",
  "name": "YYC³ AI Intelligence Platform - API Documentation",
  "readme": "none",
  "excludePrivate": true,
  "excludeProtected": false,
  "excludeInternal": true,
  "categorizeByGroup": true,
  "sort": ["source-order"],
  "searchInComments": true,
  "theme": "default",
  "gitRevision": "main",
  "includeVersion": true,
  "defaultCategory": "Core Types",
  "categoryOrder": [
    "Core Types",
    "Application Data",
    "Context & State",
    "Business Entities",
    "UI Components",
    "Hooks",
    "*"
  ],
  "visibilityFilters": {
    "protected": false,
    "private": false,
    "inherited": true,
    "external": true
  }
}
